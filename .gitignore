# Secrets and machine-specific configuration
/config/app_local.php
/config/app_local.*.php
!/config/app_local.example.php
.env
.env.*
!/config/.env.example

# Dependencies and local runtimes
/vendor/
/composer.phar
/tools/php74/
/tools/php74.old-*/
/tools/*.zip

# Private and generated data (resident files, receipts, logs, caches)
/webroot/files/
/webroot/img/files/
/webroot/*.pdf
/webroot/img/*.zip
/logs/
/tmp/
error_log
*.log
test.xlsx
*.sql.gz
*.dump

# New CakePHP 5 application (ADR-0006)
/app/vendor/
/app/config/app_local.php
/app/config/.env
/app/tmp/
/app/logs/
/app/webroot/files/

# Generated artifacts and local tool state
/.archify/
/.orchestrator/
/.clawhub/
.phpunit.result.cache

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
